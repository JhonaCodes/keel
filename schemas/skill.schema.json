{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keel:schemas:v1alpha1:skill",
  "title": "Keel Skill (keel/v1alpha1)",
  "description": "kind: Skill — spec §14.12: operational knowledge with loading levels (compact / full) and rejected/accepted example pairs that feed the `exemplar` of blocking packets (§10.4). The runtime selects compact or full by oscillation state (§6.5): nothing at start, compact on demand, full on oscillation.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "keel/v1alpha1" },
    "kind": { "const": "Skill" },
    "metadata": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "author": { "type": "string" },
        "adrRef": { "type": "string" },
        "reviewAfter": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "required": ["compact"],
      "additionalProperties": false,
      "properties": {
        "compact": {
          "type": "string",
          "description": "Workspace-relative path to the compact variant (delivered on first activation)."
        },
        "full": {
          "type": "string",
          "description": "Workspace-relative path to the full variant (delivered on oscillation, §6.5)."
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rejected", "accepted"],
            "additionalProperties": false,
            "properties": {
              "rejected": { "type": "string" },
              "accepted": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
